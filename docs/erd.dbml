// IbadahHub - Entity Relationship Diagram
// Source: Prisma migrations (PostgreSQL)
// Format: DBML — paste ke https://dbdiagram.io
//
// Multi-tenant model:
//   Religion (1) ──< TempatIbadah (1) ──< User / Jemaah / Kegiatan / Pengumuman /
//                                          Donasi / Pengeluaran / Rekening
//
// Semua resource operasional terikat ke `tempatIbadahId` (NOT NULL kecuali User).
// `religionId` di tabel anak di-denormalisasi (redundan tapi konsisten) untuk
// performa query — selalu sama dengan `TempatIbadah.religionId` rekord induknya.

//// ------------------------------------------
//// ENUMS
//// ------------------------------------------

Enum Role {
  SUPERADMIN
  PENGURUS
  JEMAAH
}

Enum SubRole {
  KETUA
  BENDAHARA
  SEKRETARIS
}

Enum StatusKegiatan {
  UPCOMING
  ONGOING
  SELESAI
  DIBATALKAN
}

Enum StatusDonasi {
  PENDING
  DIKONFIRMASI
  DITOLAK
}

Enum MetodePembayaran {
  TRANSFER_BANK
  TUNAI
  QRIS
  MIDTRANS
}

Enum StatusPengumuman {
  DRAFT
  AKTIF
  KADALUARSA
}

Enum KategoriPengeluaran {
  OPERASIONAL
  KEGIATAN
  SOSIAL
  LAINNYA
}

Enum StatusRekening {
  AKTIF
  NONAKTIF
}

Enum StatusPendaftaran {
  TERDAFTAR
  HADIR
  TIDAK_HADIR
  BATAL
}

Enum StatusTempatIbadah {
  AKTIF
  NONAKTIF
}

//// ------------------------------------------
//// TABLES
//// ------------------------------------------

Table Religion {
  id          int         [pk, increment]
  nama        text        [unique, not null]
  deskripsi   text        [null]
  createdAt   timestamp   [not null, default: `now()`]
  updatedAt   timestamp   [not null]
  deletedAt   timestamp   [null, note: 'soft delete']
}

Table TempatIbadah {
  id          int                [pk, increment]
  religionId  int                [not null, ref: > Religion.id]
  nama        text               [not null]
  slug        text               [unique, not null, note: 'URL-friendly, contoh: masjid-al-hikmah']
  alamat      text               [null]
  kota        text               [null]
  provinsi    text               [null]
  kodePos     text               [null]
  noTelp      text               [null]
  email       text               [null]
  logo        text               [null, note: 'URL logo']
  deskripsi   text               [null]
  latitude    decimal(10,7)      [null]
  longitude   decimal(10,7)      [null]
  status      StatusTempatIbadah [not null, default: 'AKTIF']
  createdBy   int                [null, note: 'User ID SUPERADMIN yang membuat, no DB-level FK']
  createdAt   timestamp          [not null, default: `now()`]
  updatedAt   timestamp          [not null]
  deletedAt   timestamp          [null, note: 'soft delete (arsip)']

  indexes {
    religionId
  }
}

Table User {
  id             int       [pk, increment]
  nama           text      [not null]
  email          text      [unique, not null]
  password       text      [not null]
  role           Role      [not null]
  subRole        SubRole   [null]
  religionId     int       [null, ref: > Religion.id]
  tempatIbadahId int       [null, ref: > TempatIbadah.id, note: 'NULL untuk SUPERADMIN; required untuk PENGURUS/JEMAAH']
  fotoProfil     text      [null]
  status         boolean   [not null, default: true]
  emailVerified  timestamp [null]
  createdAt      timestamp [not null, default: `now()`]
  updatedAt      timestamp [not null]
  deletedAt      timestamp [null, note: 'soft delete']
}

Table Session {
  id           text      [pk, note: 'CUID']
  sessionToken text      [unique, not null]
  userId       int       [not null, ref: > User.id]
  expires      timestamp [not null]
}

Table VerificationToken {
  identifier text      [not null]
  token      text      [unique, not null]
  expires    timestamp [not null]

  indexes {
    (identifier, token) [unique]
  }
}

Table Jemaah {
  id             int       [pk, increment]
  userId         int       [unique, null, ref: > User.id]
  religionId     int       [not null, ref: > Religion.id]
  tempatIbadahId int       [not null, ref: > TempatIbadah.id]
  nama           text      [not null]
  email          text      [null]
  noHp           text      [null]
  alamat         text      [null]
  status         boolean   [not null, default: true]
  createdAt      timestamp [not null, default: `now()`]
  updatedAt      timestamp [not null]
  deletedAt      timestamp [null, note: 'soft delete']

  indexes {
    tempatIbadahId
  }
}

Table Kegiatan {
  id             int            [pk, increment]
  religionId     int            [not null, ref: > Religion.id]
  tempatIbadahId int            [not null, ref: > TempatIbadah.id]
  namaKegiatan   text           [not null]
  tanggal       timestamp      [not null]
  waktuMulai    text           [not null]
  waktuSelesai  text           [null]
  lokasi        text           [not null]
  deskripsi     text           [null]
  kapasitas     int            [null]
  status        StatusKegiatan [not null, default: 'UPCOMING']
  createdBy     int            [not null, note: 'User ID, no DB-level FK constraint']
  createdAt     timestamp      [not null, default: `now()`]
  updatedAt     timestamp      [not null]
  deletedAt     timestamp      [null, note: 'soft delete']
  deletedReason text           [null]

  indexes {
    tempatIbadahId
  }
}

Table KegiatanPendaftaran {
  id         int               [pk, increment]
  kegiatanId int               [not null, ref: > Kegiatan.id]
  userId     int               [not null, ref: > User.id]
  status     StatusPendaftaran [not null, default: 'TERDAFTAR']
  catatan    text              [null]
  createdAt  timestamp         [not null, default: `now()`]
  updatedAt  timestamp         [not null]

  indexes {
    (kegiatanId, userId) [unique]
  }
}

Table Pengumuman {
  id             int              [pk, increment]
  religionId     int              [not null, ref: > Religion.id]
  tempatIbadahId int              [not null, ref: > TempatIbadah.id]
  judul          text             [not null]
  isi            text             [not null, note: 'TEXT (full text)']
  tanggalPublish timestamp        [not null, default: `now()`]
  expireDate     timestamp        [null]
  status         StatusPengumuman [not null, default: 'DRAFT']
  createdBy      int              [not null, note: 'User ID, no DB-level FK constraint']
  createdAt      timestamp        [not null, default: `now()`]
  updatedAt      timestamp        [not null]
  deletedAt      timestamp        [null, note: 'soft delete']
  deletedReason  text             [null]

  indexes {
    tempatIbadahId
  }
}

Table PengumumanLampiran {
  id           int       [pk, increment]
  pengumumanId int       [not null, ref: > Pengumuman.id]
  namaFile     text      [not null]
  url          text      [not null]
  ukuran       int       [not null, note: 'File size in bytes']
  createdAt    timestamp [not null, default: `now()`]
}

Table Donasi {
  id               int              [pk, increment]
  religionId       int              [not null, ref: > Religion.id]
  tempatIbadahId   int              [not null, ref: > TempatIbadah.id]
  userId           int              [null, ref: > User.id]
  jemaahId         int              [null, ref: > Jemaah.id]
  rekeningId       int              [null, ref: > Rekening.id]
  namaDonatur      text             [not null]
  nominal          decimal(15,2)    [not null]
  tanggal          timestamp        [not null]
  metodePembayaran MetodePembayaran [not null]
  status           StatusDonasi     [not null, default: 'PENDING']
  catatan          text             [null]
  buktiPembayaran  text             [null]
  dikonfirmasiOleh int              [null, ref: > User.id]
  dikonfirmasiAt   timestamp        [null]
  midtransOrderId  text             [unique, null]
  midtransToken    text             [null]
  midtransPaymentUrl text           [null]
  midtransStatus   text             [null]
  midtransTransactionId text        [null]
  paymentChannel   text             [null, note: 'mis. "GoPay", "BCA Virtual Account", "manual_paid"']
  createdAt        timestamp        [not null, default: `now()`]
  updatedAt        timestamp        [not null]
  deletedAt        timestamp        [null, note: 'soft delete']
  deletedReason    text             [null]

  indexes {
    tempatIbadahId
  }
}

Table Pengeluaran {
  id             int                 [pk, increment]
  religionId     int                 [not null, ref: > Religion.id]
  tempatIbadahId int                 [not null, ref: > TempatIbadah.id]
  keterangan     text                [not null]
  nominal       decimal(15,2)       [not null]
  tanggal       timestamp           [not null]
  kategori      KategoriPengeluaran [not null]
  bukti         text                [null]
  createdBy     int                 [not null, ref: > User.id]
  createdAt     timestamp           [not null, default: `now()`]
  updatedAt     timestamp           [not null]
  deletedAt     timestamp           [null, note: 'soft delete']
  deletedReason text                [null]

  indexes {
    tempatIbadahId
  }
}

Table Rekening {
  id             int            [pk, increment]
  religionId     int            [not null, ref: > Religion.id]
  tempatIbadahId int            [not null, ref: > TempatIbadah.id]
  namaBank       text           [not null]
  nomorRekening  text           [not null]
  namaPemilik    text           [not null]
  catatan        text           [null]
  status         StatusRekening [not null, default: 'AKTIF']
  createdAt      timestamp      [not null, default: `now()`]
  updatedAt      timestamp      [not null]

  indexes {
    tempatIbadahId
  }
}

Table Notifikasi {
  id        int       [pk, increment]
  userId    int       [not null, ref: > User.id]
  judul     text      [not null]
  isi       text      [not null]
  urlTujuan text      [null]
  dibaca    boolean   [not null, default: false]
  createdAt timestamp [not null, default: `now()`]
}

Table ActivityLog {
  id        int       [pk, increment]
  userId    int       [not null, ref: > User.id]
  aksi      text      [not null]
  model     text      [not null]
  recordId  int       [null]
  detail    text      [null, note: 'TEXT (full text)']
  createdAt timestamp [not null, default: `now()`]
}

//// ------------------------------------------
//// REFS TAMBAHAN (logical, no DB FK constraint)
//// ------------------------------------------

Ref: Kegiatan.createdBy > User.id
Ref: Pengumuman.createdBy > User.id

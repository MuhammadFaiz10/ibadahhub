# Database
DATABASE_URL="mysql://root:password_aman@localhost:3306/ibadahhub"

# Auth.js v5 — generate dengan: openssl rand -base64 32
AUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Resend (email)
RESEND_API_KEY="re_your_key"
EMAIL_FROM="noreply@ibadahhub.com"

# Upload
UPLOAD_DIR="./public/uploads"
MAX_FILE_SIZE_MB=5

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="IbadahHub"

# Midtrans — ambil dari dashboard.midtrans.com → Settings → Access Keys
MIDTRANS_SERVER_KEY="SB-Mid-server-xxxx"
MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxx"
MIDTRANS_IS_PRODUCTION="false"
